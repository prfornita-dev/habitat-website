<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shop | Habitat Fitness</title>
  <meta name="description" content="Habitat Fitness apparel and headwear. Available in person at Habitat Fitness, Oceanside, CA.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
  <!-- When moved into the repo, add the site's main stylesheet link here and swap the nav/footer below for the shared ones. -->
  <style>
    :root {
      --shop-bg: #0e0e0e;
      --shop-surface: #161616;
      --shop-card: #f4f3f1;
      --shop-text: #e9e7e3;
      --shop-muted: #9a978f;
      --shop-line: rgba(233, 231, 227, 0.14);
      --shop-silver: #c9c7c2;
      --shop-serif: "Cormorant Garamond", Georgia, serif;
      --shop-sans: "Inter", system-ui, -apple-system, sans-serif;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: var(--shop-bg); color: var(--shop-text); font-family: var(--shop-sans); font-weight: 300; line-height: 1.6; -webkit-font-smoothing: antialiased; }
    img { display: block; max-width: 100%; }
    a { color: inherit; text-decoration: none; }

    /* ---------- Placeholder nav (replace with site nav) ---------- */
    .shop-nav { position: sticky; top: 0; z-index: 10; display: flex; align-items: center; justify-content: space-between; padding: 22px clamp(16px, 4vw, 56px); background: rgba(14,14,14,0.92); backdrop-filter: blur(8px); border-bottom: 1px solid var(--shop-line); }
    .shop-nav__logo { font-family: var(--shop-serif); font-size: 18px; font-weight: 600; letter-spacing: 0.32em; }
    .shop-nav__links { display: flex; gap: clamp(14px, 2.4vw, 34px); list-style: none; font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; }
    .shop-nav__links a { color: var(--shop-muted); transition: color .2s; }
    .shop-nav__links a:hover, .shop-nav__links a[aria-current="page"] { color: var(--shop-text); }
    @media (max-width: 760px) { .shop-nav__links { display: none; } }

    /* ---------- Hero ---------- */
    .shop-hero { padding: clamp(72px, 12vw, 150px) clamp(16px, 4vw, 56px) clamp(48px, 7vw, 90px); text-align: center; border-bottom: 1px solid var(--shop-line); }
    .shop-eyebrow { font-size: 11px; letter-spacing: 0.34em; text-transform: uppercase; color: var(--shop-muted); margin-bottom: 22px; }
    .shop-hero h1 { font-family: var(--shop-serif); font-weight: 500; font-size: clamp(44px, 8vw, 92px); letter-spacing: 0.16em; line-height: 1.05; text-transform: uppercase; color: var(--shop-silver); }
    .shop-hero p { max-width: 520px; margin: 26px auto 0; color: var(--shop-muted); font-size: 15px; }

    /* ---------- Sections ---------- */
    .shop-section { padding: clamp(56px, 8vw, 110px) clamp(16px, 4vw, 56px); max-width: 1320px; margin: 0 auto; }
    .shop-section__head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding-bottom: 18px; margin-bottom: 36px; border-bottom: 1px solid var(--shop-line); }
    .shop-section__head h2 { font-family: var(--shop-serif); font-weight: 500; font-size: clamp(28px, 3.6vw, 40px); letter-spacing: 0.12em; text-transform: uppercase; }
    .shop-section__head span { font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase; color: var(--shop-muted); }

    .shop-grid { display: grid; gap: clamp(20px, 2.6vw, 36px); grid-template-columns: repeat(3, 1fr); }
    .shop-grid--two { grid-template-columns: repeat(2, 1fr); }
    @media (max-width: 960px) { .shop-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 620px) { .shop-grid, .shop-grid--two { grid-template-columns: 1fr; } }

    /* ---------- Product card ---------- */
    .shop-item__media { position: relative; aspect-ratio: 1 / 1; background: var(--shop-card); overflow: hidden; }
    .shop-item__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; transition: opacity .45s ease, transform .6s ease; }
    .shop-item__media .is-alt { opacity: 0; }
    @media (hover: hover) {
      .shop-item__media:hover .is-main { opacity: 0; }
      .shop-item__media:hover .is-alt { opacity: 1; transform: scale(1.02); }
    }
    .shop-item__media.is-flipped .is-main { opacity: 0; }
    .shop-item__media.is-flipped .is-alt { opacity: 1; }
    @media (hover: none) { .shop-item__media { cursor: pointer; } }
    .shop-item__view { position: absolute; left: 14px; bottom: 12px; font-size: 10px; letter-spacing: 0.26em; text-transform: uppercase; color: #6d6a64; pointer-events: none; }

    .shop-item__info { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding-top: 18px; }
    .shop-item__name { font-family: var(--shop-serif); font-size: 22px; font-weight: 500; letter-spacing: 0.04em; }
    .shop-item__price { font-size: 15px; font-weight: 400; color: var(--shop-silver); letter-spacing: 0.04em; }
    .shop-item__meta { margin-top: 4px; font-size: 13px; color: var(--shop-muted); }

    .shop-swatches { display: flex; gap: 10px; margin-top: 14px; }
    .shop-swatch { width: 22px; height: 22px; border-radius: 50%; border: 1px solid var(--shop-line); cursor: pointer; outline-offset: 3px; background: var(--c); }
    .shop-swatch[aria-pressed="true"] { outline: 1px solid var(--shop-text); }
    .shop-swatch:focus-visible { outline: 1px solid var(--shop-text); }

    /* ---------- Note ---------- */
    .shop-note { text-align: center; padding: clamp(56px, 8vw, 100px) clamp(16px, 4vw, 56px); border-top: 1px solid var(--shop-line); background: var(--shop-surface); }
    .shop-note h3 { font-family: var(--shop-serif); font-weight: 500; font-size: clamp(26px, 3.4vw, 36px); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 14px; }
    .shop-note p { color: var(--shop-muted); max-width: 480px; margin: 0 auto; font-size: 15px; }

    /* ---------- Placeholder footer (replace with site footer) ---------- */
    .shop-footer { padding: 40px clamp(16px, 4vw, 56px); border-top: 1px solid var(--shop-line); font-size: 12px; color: var(--shop-muted); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; }
  </style>
</head>
<body>

  <!-- PLACEHOLDER NAV: replace with the shared nav from index.html -->
  <header class="shop-nav">
    <a href="index.html" class="shop-nav__logo">HABITAT FITNESS</a>
    <ul class="shop-nav__links">
      <li><a href="index.html#about">About</a></li>
      <li><a href="index.html#experience">Experience</a></li>
      <li><a href="coaches.html">Coaching</a></li>
      <li><a href="shop.html" aria-current="page">Shop</a></li>
      <li><a href="index.html#contact">Contact</a></li>
    </ul>
  </header>

  <main>
    <section class="shop-hero">
      <p class="shop-eyebrow">Shop Habitat Fitness</p>
      <h1>Wear our<br>Merch</h1>
      <p>Heavyweight basics and headwear from Habitat, made for the training floor and everything after it.</p>
    </section>

    <section class="shop-section" aria-labelledby="apparel-title">
      <div class="shop-section__head">
        <h2 id="apparel-title">Apparel</h2>
        <span>02 Items</span>
      </div>
      <div class="shop-grid shop-grid--two">

        <article class="shop-item">
          <div class="shop-item__media">
            <img class="is-main" src="images/shop/tee-front.jpg" alt="Black oversized Habitat Fitness tee, front with small chest wordmark" loading="lazy">
            <img class="is-alt" src="images/shop/tee-back.jpg" alt="Black oversized Habitat Fitness tee, back with large H logo" loading="lazy">
            <span class="shop-item__view">Hover for back</span>
          </div>
          <div class="shop-item__info">
            <h3 class="shop-item__name">Oversized Heavyweight Tee</h3>
            <span class="shop-item__price">$50</span>
          </div>
          <p class="shop-item__meta">Black</p>
        </article>

        <article class="shop-item" data-variants>
          <div class="shop-item__media">
            <img class="is-main" src="images/shop/stringer-black-front.jpg" alt="Habitat Fitness stringer tank, front" loading="lazy">
            <img class="is-alt" src="images/shop/stringer-black-back.jpg" alt="Habitat Fitness stringer tank, back" loading="lazy">
            <span class="shop-item__view">Hover for back</span>
          </div>
          <div class="shop-item__info">
            <h3 class="shop-item__name">Stringer</h3>
            <span class="shop-item__price">$35</span>
          </div>
          <p class="shop-item__meta" data-color-label>Black</p>
          <div class="shop-swatches" role="group" aria-label="Stringer color">
            <button class="shop-swatch" style="--c:#111" aria-pressed="true" aria-label="Black" data-color="black" data-label="Black"></button>
            <button class="shop-swatch" style="--c:#1746c9" aria-pressed="false" aria-label="Blue" data-color="blue" data-label="Blue"></button>
            <button class="shop-swatch" style="--c:#a7a7a7" aria-pressed="false" aria-label="Grey" data-color="grey" data-label="Grey"></button>
          </div>
        </article>

      </div>
    </section>

    <section class="shop-section" aria-labelledby="headwear-title">
      <div class="shop-section__head">
        <h2 id="headwear-title">Headwear</h2>
        <span>03 Items</span>
      </div>
      <div class="shop-grid">

        <article class="shop-item">
          <div class="shop-item__media">
            <img class="is-main" src="images/shop/trucker-black-front.jpg" alt="Black Habitat Fitness trucker hat, front" loading="lazy">
            <img class="is-alt" src="images/shop/trucker-black-angle.jpg" alt="Black Habitat Fitness trucker hat, side angle with mesh back" loading="lazy">
          </div>
          <div class="shop-item__info">
            <h3 class="shop-item__name">Trucker Hat</h3>
            <span class="shop-item__price">$35</span>
          </div>
          <p class="shop-item__meta">Black</p>
        </article>

        <article class="shop-item">
          <div class="shop-item__media">
            <img class="is-main" src="images/shop/dad-hat-front.jpg" alt="Black Habitat Fitness dad hat, front" loading="lazy">
            <img class="is-alt" src="images/shop/dad-hat-angle.jpg" alt="Black Habitat Fitness dad hat, side angle" loading="lazy">
          </div>
          <div class="shop-item__info">
            <h3 class="shop-item__name">Dad Hat</h3>
            <span class="shop-item__price">$35</span>
          </div>
          <p class="shop-item__meta">Washed black</p>
        </article>

        <article class="shop-item">
          <div class="shop-item__media">
            <img class="is-main" src="images/shop/trucker-realtree-front.jpg" alt="Realtree camo Habitat Fitness trucker hat, front" loading="lazy">
            <img class="is-alt" src="images/shop/trucker-realtree-angle.jpg" alt="Realtree camo Habitat Fitness trucker hat, side angle" loading="lazy">
          </div>
          <div class="shop-item__info">
            <h3 class="shop-item__name">Realtree Trucker</h3>
            <span class="shop-item__price">$40</span>
          </div>
          <p class="shop-item__meta">Realtree camo, black mesh</p>
        </article>

      </div>
    </section>

    <section class="shop-note">
      <h3>Available In Person</h3>
      <p>All pieces are available at Habitat Fitness, 1828 Oceanside Blvd. Stop by during open hours to see sizing and pick yours up.</p>
    </section>
  </main>

  <!-- PLACEHOLDER FOOTER: replace with the shared footer from index.html -->
  <footer class="shop-footer">
    <span>Habitat Fitness, Oceanside, CA</span>
    <span>&copy; 2026 Habitat Fitness. All rights reserved.</span>
  </footer>

  <script>
    // Touch devices: tap a photo to see the other view
    if (window.matchMedia('(hover: none)').matches) {
      document.querySelectorAll('.shop-item__view').forEach(function (el) {
        el.textContent = el.textContent.replace('Hover', 'Tap');
      });
      document.querySelectorAll('.shop-item__media').forEach(function (m) {
        m.addEventListener('click', function () { m.classList.toggle('is-flipped'); });
      });
    }

    // Stringer color switcher
    document.querySelectorAll('[data-variants]').forEach(function (card) {
      var main = card.querySelector('.is-main');
      var alt = card.querySelector('.is-alt');
      var label = card.querySelector('[data-color-label]');
      card.querySelectorAll('.shop-swatch').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var c = btn.dataset.color;
          main.src = 'images/shop/stringer-' + c + '-front.jpg';
          alt.src = 'images/shop/stringer-' + c + '-back.jpg';
          label.textContent = btn.dataset.label;
          card.querySelectorAll('.shop-swatch').forEach(function (b) { b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'); });
        });
      });
    });
  </script>
</body>
</html>
